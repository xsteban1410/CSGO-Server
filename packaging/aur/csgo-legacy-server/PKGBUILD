# Maintainer: xsteban1410 <esteban1410dev at gmail dot com>
pkgname=csgo-legacy-server
pkgver=1.1.0
pkgrel=1
pkgdesc="Host a CS:GO Legacy dedicated server with bots: GTK app and command line"
arch=('x86_64')
url="https://github.com/xsteban1410/CSGO-Server"
license=('GPL-3.0-or-later')
# srcds and steamcmd are 32-bit; curl/tar to download SteamCMD, SourceMod and maps
depends=('gtk4' 'libadwaita' 'sqlite' 'curl' 'tar' 'lib32-glibc' 'lib32-gcc-libs')
makedepends=('cargo' 'go')
optdepends=('steamcmd: use the system SteamCMD instead of downloading it'
            'steam: play on this PC (CS:GO Legacy is the csgo_legacy beta of CS2)'
            'miniupnpc: open the server port on the router with UPnP'
            'systemd: keep the server running after closing the app')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# packaging/aur/publish.sh sets the real checksum when publishing to the AUR
sha256sums=('SKIP')
_dir="CSGO-Server-$pkgver"

prepare() {
  cd "$_dir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  (cd go && go mod download -modcacherw)
}

build() {
  cd "$_dir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p csgo-legacy-server -p csgo-legacy-server-gtk
  (cd go && CGO_ENABLED=0 go build -trimpath -mod=readonly -modcacherw -o ../target/release/csgo-legacy-server-agent ./cmd/agent)
}

check() {
  cd "$_dir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release -p csls-core -p csgo-legacy-server -p csgo-legacy-server-gtk
}

package() {
  cd "$_dir"
  install -Dm755 target/release/csgo-legacy-server target/release/csgo-legacy-server-gtk target/release/csgo-legacy-server-agent -t "$pkgdir/usr/bin/"
  local share="$pkgdir/usr/share/csgo-legacy-server"
  install -d "$share"
  cp -r --no-preserve=ownership game/cfg game/modes game/plugin game/data "$share/"
  find "$share" -type d -exec chmod 755 {} + && find "$share" -type f -exec chmod 644 {} +
  local id=io.github.xsteban1410.CsgoLegacyServer
  install -Dm644 "packaging/$id.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "packaging/$id.metainfo.xml" -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 "packaging/$id.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  for s in 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/$id.png"
  done
  install -Dm644 README.md README.es.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
  local bin=target/release/csgo-legacy-server
  "$bin" completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/csgo-legacy-server"
  "$bin" completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_csgo-legacy-server"
  "$bin" completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/csgo-legacy-server.fish"
}
