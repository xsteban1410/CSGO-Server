# Configuración por defecto del servidor. Las opciones de arrancar.sh / modo.sh la sobrescriben.

# Red
PUERTO=27030
# Dirección donde escucha rcon (srcds la ata a la IP del hostname; en muchas distros es 127.0.1.1)
RCON_HOST=127.0.1.1
RCON_PASSWORD=cambia_esto

# Partida al arrancar
MODO=awp
HUMANOS=2
MAPA=de_dust2
# competitivo | casual | wingman
TIPO=competitivo
# 0 fácil, 1 normal, 2 difícil, 3 experto
DIFICULTAD=3

# Servidor
TICKRATE=128
MAX_JUGADORES=20

# Mapas del workshop (-w ID): clave de la Steam Web API, https://steamcommunity.com/dev/apikey
WORKSHOP_AUTHKEY=
