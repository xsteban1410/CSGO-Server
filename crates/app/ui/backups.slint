import { Button, ScrollView } from "std-widgets.slint";
import { Group, ActionList, SpinRow, Theme } from "kit.slint";
import { S } from "state.slint";

export component BackupsPage {
    ScrollView {
        width: 100%;
        height: 100%;
        VerticalLayout {
            padding: 16px;
            spacing: Theme.page-gap;
            alignment: start;
            HorizontalLayout { alignment: end; Button { text: @tr("Make a backup"); primary: true; clicked => { S.bk-create(); } } }
            Group {
                title: @tr("Backups");
                description: @tr("Your config, modes, plugins, presets and skins, never the game. They hold your passwords: do not share them. Restoring shows what changes first. To make them regularly, add a task in Tasks.");
                ActionList { rows: S.bk-rows; empty: @tr("There are no backups"); clicked(id, action) => { S.bk-action(id, action); } }
            }
            Group {
                title: @tr("Retention");
                SpinRow {
                    title: @tr("Automatic backups to keep");
                    minimum: 1;
                    maximum: 100;
                    value <=> S.bk-keep;
                    changed value => { S.bk-keep-changed(); }
                }
            }
        }
    }
}
