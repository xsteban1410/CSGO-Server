import { Button, ScrollView } from "std-widgets.slint";
import { Group, Row, ValueRow, EntryRow, SwitchRow, Theme } from "kit.slint";
import { S } from "state.slint";

export component JoinPage {
    ScrollView {
        width: 100%;
        height: 100%;
        VerticalLayout {
            padding: 16px;
            spacing: Theme.page-gap;
            alignment: start;
            Group {
                title: @tr("Join");
                EntryRow { title: @tr("Server address"); text <=> S.jn-addr; changed text => { S.jn-addr-changed(); } }
                SwitchRow {
                    title: @tr("Through VPN bridge");
                    subtitle: @tr("Turns on by itself with a Tailscale address (100.x). The server must use the VPN profile");
                    checked <=> S.jn-vpn;
                }
                if S.jn-target != "": ValueRow {
                    title: @tr("Type in the game console");
                    value: S.jn-target;
                    Button { text: @tr("Copy"); clicked => { S.jn-copy(); } }
                }
                if S.jn-bridge: ValueRow {
                    title: @tr("Bridge running");
                    Button { text: @tr("Stop bridge"); clicked => { S.jn-stop-bridge(); } }
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                Button { text: @tr("Open CS:GO Legacy"); primary: true; clicked => { S.jn-play(); } }
                Button { text: @tr("Test connection"); clicked => { S.jn-test(); } }
                Button { text: @tr("Open CS2"); clicked => { S.jn-cs2(); } }
            }
        }
    }
}
