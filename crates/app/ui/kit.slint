// Parts every page is built from.
import { Button, LineEdit, Switch, ComboBox, SpinBox, Palette } from "std-widgets.slint";

// In dark mode, flat tones and one blue accent: canvas < card < control, hairline borders, no shadows.
// The std widgets (buttons, fields) keep their own Fluent colors: their palette cannot be set.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <length> gap: 8px;
    out property <length> page-gap: 18px;
    out property <length> radius: 8px;
    // tags and badges
    out property <length> radius-sm: 4px;
    out property <color> bg: dark ? #0a0a0a : Palette.background;
    out property <color> card: dark ? #141414 : Palette.alternate-background;
    out property <color> raised: dark ? #1e1e1e : Palette.background;
    out property <color> line: dark ? #313131 : Palette.border;
    out property <color> text: dark ? #ffffff : Palette.foreground;
    out property <color> dim: dark ? #a7a7a7 : Palette.foreground.transparentize(35%);
    out property <color> ok: dark ? #6fcf8e : #1b7f3b;
    out property <color> warn: dark ? #e8c15a : #8a6400;
    out property <color> bad: dark ? #f07a78 : #b3261e;
    out property <color> accent: dark ? #6798ff : Palette.accent-background;
    // the selected tab: a raised tone with a blue icon in dark mode, the accent in light mode
    out property <color> picked: dark ? #1e1e1e : Palette.accent-background;
    out property <color> on-picked: dark ? #ffffff : Palette.accent-foreground;
    out property <color> on-picked-icon: dark ? #6798ff : Palette.accent-foreground;
    // type scale
    out property <length> small: 12px;
    out property <length> title: 14px;
    out property <length> heading: 16px;
    out property <length> big: 20px;
    out property <length> display: 28px;
    // data (addresses, SteamIDs, maps, versions) and section labels. Slint 1.18 does not resolve the generic
    // "monospace", so a family most Linux systems ship; without it the text falls back to the UI font
    out property <string> mono: "DejaVu Sans Mono";
}

// A small upper-case monospace label over a section, like an instrument panel.
export component Eyebrow inherits Text {
    font-family: Theme.mono;
    font-size: Theme.small;
    letter-spacing: 0.85px;
    color: Theme.dim;
    vertical-alignment: center;
}

export struct Btn { id: string, label: string, danger: bool }
export struct ActionRow { id: string, title: string, subtitle: string, buttons: [Btn] }

// A title with its description, and the rows under it in one card.
export component Group {
    in property <string> title;
    in property <string> description;
    VerticalLayout {
        spacing: 6px;
        if title != "": HorizontalLayout {
            spacing: Theme.gap;
            Eyebrow { text: title.to-uppercase(); horizontal-stretch: 1; }
        }
        if description != "": Text { text: description; font-size: Theme.small; color: Theme.dim; wrap: word-wrap; }
        Rectangle {
            background: Theme.card;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 10px;
                spacing: 10px;
                @children
            }
        }
    }
}

// Title and subtitle on the left, whatever goes inside on the right.
export component Row {
    in property <string> title;
    in property <string> subtitle;
    in property <color> subtitle-color: Theme.dim;
    // monospace subtitle, for data
    in property <bool> mono;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: title; font-size: Theme.title; color: Theme.text; wrap: word-wrap; }
            if subtitle != "": Text {
                text: subtitle;
                font-size: Theme.small;
                font-family: root.mono ? Theme.mono : "";
                color: subtitle-color;
                wrap: word-wrap;
            }
        }
        @children
    }
}

// A button for what deletes or cannot be undone: drawn in the "bad" color.
export component DangerButton {
    in property <string> text;
    callback clicked();
    min-height: 30px;
    min-width: label.preferred-width + 24px;
    Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.bad;
        background: area.pressed ? Theme.bad.transparentize(70%) : area.has-hover ? Theme.bad.transparentize(85%) : transparent;
        area := TouchArea { clicked => { root.clicked(); } }
        label := Text { text: root.text; color: Theme.bad; vertical-alignment: center; horizontal-alignment: center; }
    }
}

export component ActionList {
    in property <[ActionRow]> rows;
    in property <string> empty;
    callback clicked(string, string);
    VerticalLayout {
        spacing: 10px;
        if rows.length == 0 && empty != "": Text { text: empty; color: Theme.dim; font-size: Theme.title; }
        for r in rows: Row {
            title: r.title;
            subtitle: r.subtitle;
            for b in r.buttons: HorizontalLayout {
                if !b.danger: Button { text: b.label; clicked => { root.clicked(r.id, b.id); } }
                if b.danger: DangerButton { text: b.label; clicked => { root.clicked(r.id, b.id); } }
            }
        }
    }
}

export component SwitchRow inherits Row {
    in-out property <bool> checked;
    Switch { checked <=> root.checked; }
}

export component EntryRow inherits Row {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <length> field: 280px;
    callback accepted();
    LineEdit {
        width: root.field;
        text <=> root.text;
        enabled: root.enabled;
        placeholder-text: root.placeholder;
        input-type: root.password ? InputType.password : InputType.text;
        accepted => { root.accepted(); }
    }
}

export component ComboRow inherits Row {
    in property <[string]> model;
    in-out property <int> index;
    ComboBox {
        width: 280px;
        model: root.model;
        current-index <=> root.index;
    }
}

export component SpinRow inherits Row {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <bool> enabled: true;
    in-out property <int> value;
    SpinBox {
        width: 160px;
        minimum: root.minimum;
        maximum: root.maximum;
        step-size: root.step;
        enabled: root.enabled;
        value <=> root.value;
    }
}

// A value and, on the right, what acts on it.
export component ValueRow inherits Row {
    in property <string> value;
    in property <color> value-color: Theme.dim;
    subtitle: root.value == "" ? "—" : root.value;
    subtitle-color: root.value-color;
}

// One figure, large, with what it is under it. Flat: tone and a hairline, no shadow.
export component StatCard {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text;
    min-width: 120px;
    horizontal-stretch: 1;
    Rectangle {
        background: Theme.card;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.line;
        VerticalLayout {
            padding: 12px;
            spacing: 4px;
            Text {
                text: root.value == "" ? "—" : root.value;
                font-size: Theme.big;
                font-weight: 600;
                color: root.value-color;
                overflow: elide;
            }
            Eyebrow { text: root.label.to-uppercase(); overflow: elide; }
        }
    }
}

// Darkens what is behind and holds a card in the middle.
export component Overlay {
    in property <length> card-width: 640px;
    in property <length> card-height: 720px;
    width: 100%;
    height: 100%;
    Rectangle {
        background: #00000080;
        TouchArea { }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(root.card-width, root.width - 24px);
        height: min(root.card-height, root.height - 24px);
        background: Theme.bg;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.line;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            @children
        }
    }
}
