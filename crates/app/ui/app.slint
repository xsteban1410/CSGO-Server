import { Button, Palette } from "std-widgets.slint";
import { Theme, Overlay, Eyebrow } from "kit.slint";
import { S, Tabs, ActionRow, Btn, ConsoleLine, Card, HubCard, KeyValue, ModeItem, TeamEdit, RuleEdit, Bar } from "state.slint";
import { ServerPage } from "server.slint";
import { SetupPage } from "setup.slint";
import { Wizard } from "wizard.slint";
import { PlayersPage, BanDialog, SkinsDialog, SanctionDialog, AdminDialog } from "players.slint";
import { ModesPage, ModeEditor } from "modes.slint";
import { WorkshopPage } from "workshop.slint";
import { ConsolePage, AliasDialog } from "console.slint";
import { HubPage, HubDetail } from "hub.slint";
import { SettingsPage } from "settings.slint";
import { PluginsPage } from "plugins.slint";
import { SchedulePage } from "schedule.slint";
import { BackupsPage } from "backups.slint";
import { StatsPage } from "stats.slint";
import { UpdatesPage } from "updates.slint";

export { S, Tabs, ActionRow, Btn, ConsoleLine, Card, HubCard, KeyValue, ModeItem, TeamEdit, RuleEdit, Bar }

struct TabInfo { label: string, icon: image, section: string }

// The tabs in groups, each with an icon; arrow keys move between them once the rail has focus.
component Rail {
    in-out property <int> index;
    in property <[TabInfo]> tabs;
    Rectangle {
        background: Theme.card;
        keys := FocusScope {
            key-pressed(e) => {
                if e.text == Key.UpArrow { root.index = max(0, root.index - 1); return accept; }
                if e.text == Key.DownArrow { root.index = min(root.tabs.length - 1, root.index + 1); return accept; }
                reject
            }
        }
        VerticalLayout {
            padding: 8px;
            spacing: 2px;
            alignment: start;
            for t[i] in root.tabs: VerticalLayout {
                spacing: 2px;
                if t.section != "": Eyebrow {
                    text: t.section;
                    height: i == 0 ? 20px : 30px;
                    vertical-alignment: bottom;
                    x: 10px;
                }
                Rectangle {
                    height: 34px;
                    border-radius: Theme.radius;
                    background: root.index == i ? Theme.picked : area.has-hover ? Palette.border : transparent;
                    border-width: keys.has-focus && root.index == i ? 2px : 0px;
                    border-color: Palette.foreground;
                    area := TouchArea { clicked => { root.index = i; keys.focus(); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 10px;
                        Image {
                            source: t.icon;
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            colorize: root.index == i ? Theme.on-picked-icon : Theme.text;
                        }
                        Text {
                            text: t.label;
                            vertical-alignment: center;
                            overflow: elide;
                            color: root.index == i ? Theme.on-picked : Theme.text;
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "CS:GO Legacy Server";
    preferred-width: 1040px;
    preferred-height: 700px;
    min-width: 640px;
    min-height: 460px;
    icon: @image-url("../../../packaging/io.github.xsteban1410.CsgoLegacyServer.svg");
    Rectangle { background: Theme.bg; }
    HorizontalLayout {
        Rail {
            width: 170px;
            index <=> S.tab;
            tabs: [
                { label: @tr("Server"), icon: @image-url("icons/server.svg"), section: @tr("SERVER") },
                { label: @tr("Console"), icon: @image-url("icons/console.svg") },
                { label: @tr("Players"), icon: @image-url("icons/players.svg") },
                { label: @tr("Statistics"), icon: @image-url("icons/stats.svg") },
                { label: @tr("Modes"), icon: @image-url("icons/modes.svg"), section: @tr("CONTENT") },
                { label: "Hub", icon: @image-url("icons/hub.svg") },
                { label: @tr("Workshop"), icon: @image-url("icons/workshop.svg") },
                { label: @tr("Plugins"), icon: @image-url("icons/plugins.svg") },
                { label: @tr("Tasks"), icon: @image-url("icons/tasks.svg"), section: @tr("MANAGE") },
                { label: @tr("Backups"), icon: @image-url("icons/backups.svg") },
                { label: @tr("Updates"), icon: @image-url("icons/updates.svg") },
                { label: @tr("Settings"), icon: @image-url("icons/settings.svg") },
            ];
        }
        Rectangle {
            horizontal-stretch: 1;
            if S.tab == Tabs.server: ServerPage { width: 100%; height: 100%; }
            if S.tab == Tabs.console: ConsolePage { width: 100%; height: 100%; }
            if S.tab == Tabs.players: PlayersPage { width: 100%; height: 100%; }
            if S.tab == Tabs.stats: StatsPage { width: 100%; height: 100%; }
            if S.tab == Tabs.modes: ModesPage { width: 100%; height: 100%; }
            if S.tab == Tabs.hub: HubPage { width: 100%; height: 100%; init => { S.hb-shown(); } }
            if S.tab == Tabs.workshop: WorkshopPage { width: 100%; height: 100%; init => { S.ws-shown(); } }
            if S.tab == Tabs.plugins: PluginsPage { width: 100%; height: 100%; }
            if S.tab == Tabs.tasks: SchedulePage { width: 100%; height: 100%; }
            if S.tab == Tabs.backups: BackupsPage { width: 100%; height: 100%; }
            if S.tab == Tabs.updates: UpdatesPage { width: 100%; height: 100%; }
            if S.tab == Tabs.settings: SettingsPage { width: 100%; height: 100%; }
        }
    }
    if S.setup != "": SetupPage { width: 100%; height: 100%; }
    if S.wiz-open: Wizard { width: 100%; height: 100%; }
    if S.ban-open: BanDialog { width: 100%; height: 100%; }
    if S.skins-open: SkinsDialog { width: 100%; height: 100%; }
    if S.san-open: SanctionDialog { width: 100%; height: 100%; }
    if S.ad-open: AdminDialog { width: 100%; height: 100%; }
    if S.con-alias-open: AliasDialog { width: 100%; height: 100%; }
    if S.ed-open: ModeEditor { width: 100%; height: 100%; }
    if S.hb-detail-open: HubDetail { width: 100%; height: 100%; }
    if S.alert-open: Overlay {
        card-width: 460px;
        card-height: 240px;
        Text { text: S.alert-title; font-size: Theme.heading; font-weight: 600; color: Theme.text; }
        Text { text: S.alert-text; wrap: word-wrap; color: Theme.text; vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if S.alert-no != "": Button { text: S.alert-no; clicked => { S.alert-open = false; S.alert-answer(false); } }
            Button { text: S.alert-yes; primary: !S.alert-danger; clicked => { S.alert-open = false; S.alert-answer(true); } }
        }
    }
    if S.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 16px;
        width: min(parent.width - 32px, toast-text.preferred-width + 32px);
        height: toast-text.preferred-height + 16px;
        background: Palette.foreground;
        border-radius: Theme.radius;
        toast-text := Text {
            x: 16px;
            y: 8px;
            width: parent.width - 32px;
            text: S.toast;
            color: Palette.background;
            wrap: word-wrap;
        }
    }
}

export component Tray inherits SystemTrayIcon {
    in property <bool> running;
    in property <bool> live;
    in property <string> status;
    callback open();
    callback console();
    callback start();
    callback change();
    callback stop();
    callback quit();
    icon: @image-url("../../../packaging/icons/64.png");
    tooltip: status;
    title: "CS:GO Legacy Server";
    clicked => { open(); }
    Menu {
        MenuItem { title: status; enabled: false; }
        MenuItem { title: @tr("Open"); activated => { open(); } }
        MenuItem { title: @tr("Console"); activated => { console(); } }
        if !running: MenuItem { title: @tr("Start server"); activated => { start(); } }
        if live: MenuItem { title: @tr("Change mode or map"); activated => { change(); } }
        if running: MenuItem { title: @tr("Stop"); activated => { stop(); } }
        MenuItem { title: @tr("Quit"); activated => { quit(); } }
    }
}
